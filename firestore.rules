rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Check if user is signed in with Firebase Auth.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Platform Super Admin: anonto.kings9@gmail.com, estate.admin@remotizedit.online, admin@remotizedit.online.
     * Super Admin check is strictly based on the cryptographically signed JWT token email to prevent privilege injection.
     */
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'anonto.kings9@gmail.com',
        'admin@remotizedit.online',
        'estate.admin@remotizedit.online'
      ];
    }

    /**
     * Fetch user profile data from /users/{uid}.
     */
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /**
     * Retrieve the user's role ('SuperAdmin', 'Admin', 'Accountant', 'Viewer').
     */
    function getRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().get('role', 'Viewer')
        : 'Viewer';
    }

    /**
     * Role checking helpers.
     */
    function isAdmin() {
      return isSignedIn() && (isSuperAdmin() || getRole() == 'Admin');
    }

    function isAccountant() {
      return isSignedIn() && (isSuperAdmin() || getRole() == 'Accountant' || getRole() == 'Admin');
    }

    // --------------------------------------------------------------------------
    // Collection Group Queries (required for Dashboard metrics across projects)
    // --------------------------------------------------------------------------
    match /{path=**}/inflowTransactions/{transactionId} {
      allow read: if isSignedIn();
      allow write: if isAccountant();
    }

    match /{path=**}/outflowTransactions/{transactionId} {
      allow read: if isSignedIn();
      allow write: if isAccountant();
    }

    match /{path=**}/flats/{flatId} {
      allow read: if isSignedIn();
      allow write: if isAccountant();
    }

    // --------------------------------------------------------------------------
    // Tenants & Workspaces (/tenants)
    // --------------------------------------------------------------------------
    match /tenants/{tenantId} {
      allow read: if isSignedIn();
      // Only platform Super Admins can provision or delete tenants
      allow create, delete: if isSuperAdmin();
      // Admins can update their own organization workspace metadata, SuperAdmin can update all
      allow update: if isSuperAdmin() || (
        isAdmin() && getUserData().get('tenantId', '') == tenantId
      );
    }

    // --------------------------------------------------------------------------
    // Tenant Invitations (/tenant_invites)
    // --------------------------------------------------------------------------
    match /tenant_invites/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || isAdmin();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // --------------------------------------------------------------------------
    // User Profiles (/users)
    // --------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      // Only SuperAdmin can create SuperAdmin accounts. Users can create their own non-SuperAdmin profile.
      allow create: if isSuperAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.get('role', 'Viewer') != 'SuperAdmin'
      );
      // Strictly prevent self-privilege escalation: users cannot change their own role, tenantId, or email
      allow update: if isSuperAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.get('role', '') == resource.data.get('role', '') &&
        request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '') &&
        request.resource.data.get('email', '') == resource.data.get('email', '')
      ) || (
        // Organization Admin can only manage non-SuperAdmin users within their own tenant
        isAdmin() &&
        resource.data.get('tenantId', '') == getUserData().get('tenantId', '') &&
        request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '') &&
        request.resource.data.get('role', '') != 'SuperAdmin'
      );
      allow delete: if isSuperAdmin();
    }

    // --------------------------------------------------------------------------
    // Projects & Subcollections (/projects)
    // --------------------------------------------------------------------------
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isAccountant();
      allow delete: if isAdmin();

      match /flats/{flatId} {
        allow read: if isSignedIn();
        allow write: if isAccountant();
      }

      match /inflowTransactions/{transactionId} {
        allow read: if isSignedIn();
        allow create, update: if isAccountant();
        allow delete: if isAdmin();
      }

      match /outflowTransactions/{transactionId} {
        allow read: if isSignedIn();
        allow create, update: if isAccountant();
        allow delete: if isAdmin();
      }

      match /officeCostAllocations/{allocationId} {
        allow read: if isSignedIn();
        allow write: if isAccountant();
      }
    }

    // --------------------------------------------------------------------------
    // Customers (/customers)
    // --------------------------------------------------------------------------
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update: if isAccountant();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // Vendors (/vendors)
    // --------------------------------------------------------------------------
    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow create, update: if isAccountant();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // Sales (/sales)
    // --------------------------------------------------------------------------
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create, update: if isAccountant();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // Expenses (/expenses)
    // --------------------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create, update: if isAccountant();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // Operating Costs (/operatingCosts)
    // --------------------------------------------------------------------------
    match /operatingCosts/{costId} {
      allow read: if isSignedIn();
      allow create, update: if isAccountant();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // Item Categories & Setup
    // --------------------------------------------------------------------------
    match /expenseItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAccountant();
    }

    match /operatingCostItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAccountant();
    }

    // --------------------------------------------------------------------------
    // Sequential Receipt Counters (/counters)
    // --------------------------------------------------------------------------
    match /counters/{counterId} {
      allow read, write: if isAccountant();
    }

    // --------------------------------------------------------------------------
    // Platform & Tenant Notices (/notices)
    // --------------------------------------------------------------------------
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --------------------------------------------------------------------------
    // User Provisioning Requests (/user_requests)
    // --------------------------------------------------------------------------
    match /user_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // --------------------------------------------------------------------------
    // Password Reset Tokens (/password_resets)
    // Completely isolated from client SDK access. Only server Firebase Admin SDK can access.
    // --------------------------------------------------------------------------
    match /password_resets/{tokenId} {
      allow read, write: if false;
    }
  }
}
