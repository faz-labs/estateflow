# ==============================================================================
# EstateFlow SaaS Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Required for Web App)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 2. Self-Hosted Mailcow SMTP Server Configuration (Password Reset & Team Invites)
# ------------------------------------------------------------------------------
# Mailcow hostname (e.g., mail.remotizedit.online)
SMTP_HOST=mail.yourdomain.com
# Port 587 (STARTTLS) or 465 (SSL/TLS)
SMTP_PORT=587
# Set to true if using port 465, false for port 587
SMTP_SECURE=false
# Mailcow mailbox email address used for authenticating (e.g., noreply@remotizedit.online)
SMTP_USER=noreply@yourdomain.com
# Mailcow mailbox password for this email account
SMTP_PASS=your_mailcow_mailbox_password
# Sender display name and email address
SMTP_FROM_NAME="EstateFlow Support"
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ------------------------------------------------------------------------------
# 3. Google Gemini AI / Genkit Configuration (Required for AI Forecasting)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. App URL (Used for generating reset links)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:9002

# ------------------------------------------------------------------------------
# 5. Platform Super Admin Access (Optional comma-separated emails)
# ------------------------------------------------------------------------------
# Additional emails that should have full Platform Super Admin dashboard access.
# Defaults: anonto.kings9@gmail.com, admin@remotizedit.online, estate.admin@remotizedit.online
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=
